# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# Arbitrum. 421614 = Sepolia testnet, 42161 = Arbitrum One mainnet.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc

# Arbiscan API key, for `forge verify-contract` / `--verify` on deploy scripts.
ARBISCAN_API_KEY=

# Deployer key, used by script/*.s.sol via `vm.envUint("PRIVATE_KEY")`.
# NEVER a real funded key outside of local anvil / testnet throwaway wallets.
PRIVATE_KEY=

# The pause guardian (GHO-31). The only address that can halt new deposits,
# supplies, borrows and positions — and the only thing it can do. It cannot
# move a token, cannot change a parameter, and cannot stop anyone leaving:
# withdrawing, repaying, claiming, liquidating and settling an open round all
# stay reachable while paused, by construction.
#
# Worth setting to a different key from the deployer on anything real. Pausing
# is what you do at four in the morning from a laptop, so it should be a hot
# key — which is exactly the key that should not also own the reserves.
#
# Defaults to the deployer when unset, so a local run needs no configuration.
PAUSE_GUARDIAN=

# ── Arbitrum Sepolia deploy (GHO-27 / GHO-21) ─────────────────────────
# Generated per-machine into .env, which is gitignored. Testnet only —
# never reuse a deployer key anywhere with real value.
PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Verified live on Arbitrum Sepolia by calling description() on-chain,
# not copied from a docs page. Re-verify before trusting either.
#   BTC / USD   0x56a43EB56Da12C0dc1D972ACb089c06a5dEF8e69  (8 decimals)
#   USDC / USD  0x0153002d20B96532C639313c2d54c3dA09109309  (8 decimals)
FEED_ADDRESS=0x56a43EB56Da12C0dc1D972ACb089c06a5dEF8e69

# Chainlink's L2 sequencer uptime feed. NO address for this was found on
# Arbitrum Sepolia — the mainnet one (0xFdB631F5...) is not deployed there.
# Left empty, which DISABLES the check. That is acceptable on a demo testnet
# and wrong on anything real: without it, rounds can settle against a market
# nobody could reach during downtime. Must be set for GHO-21.
SEQUENCER_FEED_ADDRESS=

# Heartbeat plus a buffer, from the feed's own page. Never guessed.
MAX_STALENESS=3600
SEQUENCER_GRACE=1800
