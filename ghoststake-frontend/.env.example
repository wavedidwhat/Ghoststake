# Copy to .env.local. All values here are public by definition — they ship to
# the browser. Never put a secret behind a NEXT_PUBLIC_ prefix.

# Go API (SIWE auth). Must be in the backend's CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Must match the backend's CHAIN_ID. 421614 = Arbitrum Sepolia.
NEXT_PUBLIC_CHAIN_ID=421614

# Optional: overrides the chain's default public RPC. Set this to a private
# endpoint before a demo — public RPCs rate-limit under a live audience.
NEXT_PUBLIC_RPC_URL=

# Contract addresses. Left blank until GHO-21 deploys; the dashboard renders
# an explicit "not deployed" state rather than a page full of zeroes.
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_POOL_ADDRESS=
