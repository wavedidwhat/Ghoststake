# Copy to .env.local. All values here are public by definition — they ship to
# the browser. Never put a secret behind a NEXT_PUBLIC_ prefix.

# Go API (SIWE auth). Must be in the backend's CORS_ORIGINS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Must match the backend's CHAIN_ID. 46630 = Robinhood Chain testnet (the
# GHO-21 target), 421614 = Arbitrum Sepolia, 11155111 = Sepolia, 31337 = anvil.
NEXT_PUBLIC_CHAIN_ID=421614

# Optional: overrides the chain's default public RPC. Set this to a private
# endpoint before a demo — public RPCs rate-limit under a live audience.
NEXT_PUBLIC_RPC_URL=

# Contract addresses. Left blank until GHO-21 deploys; the dashboard renders
# an explicit "not deployed" state rather than a page full of zeroes.
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_POOL_ADDRESS=

# Optional: Reown (WalletConnect) project id, 32 hex chars. Without it the
# connect menu offers no WalletConnect option, so phones without a browser
# wallet can only use the Coinbase app. Restrict its allowed origins in the
# Reown dashboard. The deployed value is the default in docker-compose.yml.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
