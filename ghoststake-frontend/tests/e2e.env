# The configuration the browser tests are built with (GHO-87).
#
# Loaded by `pnpm build:e2e` through `node --env-file`, which sets these before
# Next reads any .env file, so a developer's .env.local cannot leak real
# addresses or a real API into the test build. CI builds with this same file.
#
# Every address is one tests/mock-chain.ts answers for, and the RPC is a host
# that does not exist: an unmocked read fails at once instead of reaching a
# real network. 31337 is the mock wallet's default chain.

NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=https://rpc.e2e.ghoststake.test
NEXT_PUBLIC_API_URL=http://127.0.0.1:9
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3311
NEXT_PUBLIC_VAULT_ADDRESS=0x00000000000000000000000000000000000e2e01
NEXT_PUBLIC_POOL_ADDRESS=0x00000000000000000000000000000000000e2e02
NEXT_PUBLIC_MARKET_ADDRESS=0x00000000000000000000000000000000000e2e03
NEXT_PUBLIC_ROUTER_ADDRESS=0x00000000000000000000000000000000000e2e04
NEXT_PUBLIC_DEMO_MARKET_ADDRESS=
NEXT_PUBLIC_DEMO_ROUTER_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_STOCK_VAULT_ADDRESS=0x00000000000000000000000000000000000e2e08
