# Copy to .env and fill in. .env is gitignored; never commit real secrets.

APP_ENV=development
HTTP_PORT=8080

# Postgres
POSTGRES_USER=ghoststake
POSTGRES_PASSWORD=ghoststake
POSTGRES_DB=ghoststake
DATABASE_URL=postgres://ghoststake:ghoststake@localhost:5432/ghoststake?sslmode=disable

# Session signing key. Generate with: openssl rand -hex 32
# Required (and must be >= 32 bytes) whenever APP_ENV is not "development".
JWT_SECRET=
JWT_TTL=24h

# How long a login challenge stays valid.
NONCE_TTL=5m

# Bound into the SIWE message the wallet signs. These MUST match the site the
# user is actually on, or the signature becomes replayable across origins.
APP_DOMAIN=localhost:3000
APP_URI=http://localhost:3000

# Arbitrum. 421614 = Sepolia testnet, 42161 = Arbitrum One mainnet.
CHAIN_ID=421614
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

CORS_ORIGINS=http://localhost:3000

# ── Indexer ───────────────────────────────────────────────────────────
# Off by default. The contracts are not deployed yet, and an indexer aimed
# at an address with no code polls forever and finds nothing.
INDEXER_ENABLED=false

# Required when INDEXER_ENABLED=true. From the GHO-21 deploy.
VAULT_ADDRESS=
POOL_ADDRESS=
# The parimutuel market. Required too since GHO-17: the indexer covers round
# lifecycle events and the API serves rounds and positions from them.
#
# Every market to index, comma-separated. `round_events` carries a market since
# GHO-43, so a round is identified by (market, round id) and two markets no
# longer merge into one set of ids.
#
# The singular MARKET_ADDRESS is still read when this is unset, because every
# deployed .env writes it — but it indexes one market and the API is then
# blind to the rest, which is what GHO-43 fixed.
#
# Adding a market changes the cursor fingerprint, so the indexer refuses to
# start until the derived index is reset. That is deliberate: resuming would
# skip the new market's history and report healthy while indexing none of it.
MARKET_ADDRESSES=

# The deployment block. Required when enabled: starting from 0 means scanning
# the whole chain to find the first event.
INDEXER_START_BLOCK=

# How far behind the head to stay before writing. Covers sequencer
# reordering, which is the reorg risk that applies on an L2.
INDEXER_CONFIRMATIONS=5

# Bounds one eth_getLogs range; public RPCs reject wide ones.
INDEXER_BATCH_SIZE=2000

# Decline the one-time re-read that a decoder change asks for.
#
# When a decoder starts deriving a record it did not derive before, every log
# already indexed is missing it — nothing revisits a block the cursor has
# passed. The indexer notices (the cursor carries the decoder version it was
# written by) and replays its range once, deleting nothing: the re-read is a
# no-op for every row that exists and an insert for every one that does not.
#
# Set this to true to keep the gap instead, on a deployment where re-reading
# is not worth it — a pruned RPC, or history older than anything anyone will
# look at. It is logged either way.
INDEXER_SKIP_DECODER_REPLAY=false
INDEXER_POLL_INTERVAL=12s

# ── Keeper (GHO-24) ───────────────────────────────────────────────────
# Read by `cmd/keeper`, never by the API. The keeper is a separate binary and
# a separate container precisely so the key below exists in exactly one
# process — everything else in the Go layer is strictly read-only.
#
# Deployed with `docker compose -f docker-compose.yml -f docker-compose.keeper.yml`,
# which reads these from `.env.keeper` rather than from this file. They are
# documented here because this is where an operator looks.

# The hot wallet. Hex, with or without 0x. Needs a little gas and nothing
# else: it never holds user funds, and the only privileged things it can do
# are open rounds and refund ones nobody could settle.
#
# It must be the markets' owner for `openRound` to succeed. It does not need
# to be for anything else — lockRound, resolveRound and voidUnlockedRound are
# permissionless by design, so a keeper on an unprivileged key still advances
# every round somebody else opened.
KEEPER_PRIVATE_KEY=

# Which markets to drive. The registry is preferred: listing a market is a
# transaction rather than a redeploy. KEEPER_MARKET_ADDRESSES is a
# comma-separated fallback for a deployment predating the registry, and falls
# back in turn to MARKET_ADDRESSES above.
REGISTRY_ADDRESS=
KEEPER_MARKET_ADDRESSES=

# How often every market is examined. Must be comfortably shorter than the
# market's lock window or rounds void instead of settling — the keeper
# refuses to start otherwise rather than discovering it a round at a time.
KEEPER_POLL_INTERVAL=10s

# Whether to open new rounds at all. Off leaves a keeper that only advances
# rounds somebody else opened, which is the right shape when the owner key
# lives elsewhere.
KEEPER_OPEN_ROUNDS=true

# Seconds ahead of now that a new round opens. `openRound` rejects a start in
# the past, and the gap between simulating and mining eats a short lead.
KEEPER_LEAD=45

# Round length, open to close, for a market the registry gives no horizon
# for. Split half to taking positions and half to watching the price, unless
# KEEPER_ENTRY_WINDOW names the first half explicitly.
KEEPER_HORIZON=3600
KEEPER_ENTRY_WINDOW=

# Bounds round length on dates the trading calendar does not cover. Past the
# last year in Session's holiday list the keeper degrades to short rounds
# against a feed it has confirmed is publishing, rather than stopping the
# market — an expired list should not be a dead man's switch. Extend the list.
KEEPER_MAX_UNCALENDARED_ROUND=15m

# Optional. `market=statusFeed` pairs, comma-separated, where the status feed
# is an AggregatorV3Interface whose answer is a flag rather than a price:
# non-zero means the venue is open. Authoritative when set — a venue
# publishing its own state beats anything inferred from a calendar or a
# cadence. Nothing depends on it, and most deployments leave it empty.
#
#   KEEPER_MARKET_STATUS_FEEDS=0xMarket=0xStatus,0xOther=0xOtherStatus
KEEPER_MARKET_STATUS_FEEDS=

# Balance below which the keeper warns on every tick. It never stops trying:
# a keeper that refused to send is indistinguishable from one out of gas, and
# the one that tries at least lands what it can still afford. 0.01 ETH.
KEEPER_MIN_GAS_BALANCE_WEI=10000000000000000

# Integration tests only. `make test-remote` sets this itself via rdk.
TEST_DATABASE_URL=

# Permit booting against a database migrated further than this binary knows.
# Off by default; see store.Migrate. Only set this after checking that every
# migration the database has and the binary lacks is additive.
ALLOW_SCHEMA_AHEAD=false
