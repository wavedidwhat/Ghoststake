# Copy to .env.keeper and fill in. .env.keeper is gitignored.
#
# The round keeper's environment, and nothing else's. This file exists
# separately from `.env` on purpose: it holds a private key, and the keeper is
# a separate binary in a separate container so that key lives in exactly one
# process. Do not merge these into `.env` — the API would then carry them, and
# the isolation is the whole point.
#
# See .env.example for what each of these means in full.

# The hot wallet. Needs a little gas. Must be the markets' owner if the keeper
# is to open rounds; everything else it does is permissionless.
KEEPER_PRIVATE_KEY=

# Which markets to drive. Prefer the registry.
REGISTRY_ADDRESS=
KEEPER_MARKET_ADDRESSES=

# Must be comfortably shorter than the market's lock window.
KEEPER_POLL_INTERVAL=10s

KEEPER_OPEN_ROUNDS=true
KEEPER_LEAD=45
KEEPER_HORIZON=3600
KEEPER_ENTRY_WINDOW=

# 0.01 ETH.
KEEPER_MIN_GAS_BALANCE_WEI=10000000000000000
