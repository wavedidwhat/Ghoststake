# Copy to .env.keeper and fill in. .env.keeper is gitignored.
#
# The round keeper's environment, and nothing else's. This file exists
# separately from `.env` on purpose: it holds a private key, and the keeper is
# a separate binary in a separate container so that key lives in exactly one
# process. Do not merge these into `.env` — the API would then carry them, and
# the isolation is the whole point.
#
# See .env.example for what each of these means in full.

# The hot wallet. Needs a little gas. Must be the markets' owner if the keeper
# is to open rounds; everything else it does is permissionless.
KEEPER_PRIVATE_KEY=

# Which markets to drive. Prefer the registry.
REGISTRY_ADDRESS=
KEEPER_MARKET_ADDRESSES=

# Must be comfortably shorter than the market's lock window.
KEEPER_POLL_INTERVAL=10s

KEEPER_OPEN_ROUNDS=true
KEEPER_LEAD=45
KEEPER_HORIZON=3600
KEEPER_ENTRY_WINDOW=

# 0.01 ETH.
KEEPER_MIN_GAS_BALANCE_WEI=10000000000000000

# Bounds round length on dates the trading calendar does not cover. Past the
# last year in Session's holiday list the keeper degrades to short rounds
# against a feed it has confirmed is publishing, rather than stopping the
# market — an expired list should not be a dead man's switch. Extend the list.
KEEPER_MAX_UNCALENDARED_ROUND=15m

# How often the market registry is re-read for listing changes. Much slower
# than KEEPER_POLL_INTERVAL on purpose: the round loop runs every ten seconds
# because a lock window is measured in tens of seconds, and the set of listed
# markets changes about never. A delisted market keeps being driven until its
# last open round settles, so this is only how long a *new* listing waits.
KEEPER_REGISTRY_REFRESH_INTERVAL=1m

# Optional. `market=statusFeed` pairs, comma-separated, where the status feed
# is an AggregatorV3Interface whose answer is a flag rather than a price:
# non-zero means the venue is open. Authoritative when set — a venue
# publishing its own state beats anything inferred from a calendar or a
# cadence. Nothing depends on it, and most deployments leave it empty.
#
#   KEEPER_MARKET_STATUS_FEEDS=0xMarket=0xStatus,0xOther=0xOtherStatus
KEEPER_MARKET_STATUS_FEEDS=
