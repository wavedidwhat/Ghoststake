# In-container defaults for docker compose. Committed on purpose — these are
# topology, not secrets: they describe how the containers reach each other.
#
# `.env` is layered on top of this file and wins on any key it sets, so an
# operator overrides a default by naming it in `.env` and never by editing
# this file. Nothing here may be a real credential.
#
# Why this file exists at all: these used to be `${VAR:-default}` expressions
# inside docker-compose.yml. Compose resolves those against whichever env file
# the *client* was invoked with, and the RDK extension invokes it with
# `--env-file .env.remote` — RDK's own settings file, which has none of these
# keys. Every default silently applied and the one required key failed the
# deploy outright. Values reach the container through `env_file` now, which
# does not depend on how the client was called.

APP_ENV=production
HTTP_PORT=8080

# Points at the `db` service on the compose network. Change this together with
# the POSTGRES_* values below — they describe the same database, and moving one
# without the other produces an API that cannot authenticate to its own
# Postgres.
DATABASE_URL=postgres://ghoststake:ghoststake@db:5432/ghoststake?sslmode=disable
POSTGRES_USER=ghoststake
POSTGRES_PASSWORD=ghoststake
POSTGRES_DB=ghoststake

JWT_TTL=24h
NONCE_TTL=5m

APP_DOMAIN=localhost:3000
APP_URI=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

CHAIN_ID=421614
RPC_URL=
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Indexer. Off unless addresses are supplied — an indexer aimed at an address
# with no code polls forever and finds nothing.
INDEXER_ENABLED=false
VAULT_ADDRESS=
POOL_ADDRESS=
MARKET_ADDRESS=
INDEXER_START_BLOCK=0
INDEXER_CONFIRMATIONS=5
INDEXER_BATCH_SIZE=2000
INDEXER_POLL_INTERVAL=12s

# Deliberately absent: JWT_SECRET. There is no safe default for it, and
# config.Load refuses to boot outside development without one — which is the
# check that should fail, in the API's own logs, rather than a compose
# interpolation error that names no reason.
